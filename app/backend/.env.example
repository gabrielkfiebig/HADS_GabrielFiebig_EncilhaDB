DATABASE_URL=postgresql+psycopg2://postgres:senha@localhost:5432/encilhadb

# Uso local. Sem curingas e sem acesso remoto à aplicação.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Destinos dos testes: adicione somente as redes estritamente necessárias.
DB_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Opcional: nomes mapeados para IPs fixos, sem resolução DNS.
# O IP também precisa pertencer a DB_ALLOWED_NETWORKS.
# DB_HOST_MAP=db01.interno=192.168.1.10
